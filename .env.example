# Public trend discovery. Create a restricted server-side key in Google Cloud
# and enable YouTube Data API v3. Never expose this value in client-side code.
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
YOUTUBE_CATEGORY_ID=0
TREND_QUERIES=future technology,hidden economy,behavior science,energy breakthrough,space economy
TREND_AUTOSCAN_MINUTES=120
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5195/api/youtube/oauth/callback

# Required in production. The app falls back to demo memory storage only when
# this is empty and APP_ENV is not production.
DATABASE_URL=
APP_ENV=development
SESSION_SECRET=
AUTH_REQUIRED=false
LOCAL_SEED_OWNER_EMAIL=owner@nocturn-youtube.local
LOCAL_SEED_OWNER_PASSWORD=

# AI provider activation. Jobs can be created without a key and remain in
# waiting_for_provider until the server-side credential is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Optional production adapters. Without these, jobs persist safely in a
# waiting state and cannot be marked complete.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ELEVENLABS_API_KEY=
# George (premade, documentary tone). Change after a voice test.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Free key from pexels.com/api; without it scenes use generated typographic cards.
PEXELS_API_KEY=
MEDIA_DIR=./media
CHANNEL_NAME=
# Development only: macOS `say` narration when ElevenLabs is not configured.
ALLOW_LOCAL_TTS=false
WORKER_POLL_SECONDS=15
RENDER_PROVIDER_API_KEY=
